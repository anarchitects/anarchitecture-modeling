{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/yarn.lock",
      "{workspaceRoot}/.yarnrc.yml",
      "{workspaceRoot}/tsconfig*.json",
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/tools/ci/**/*",
      {
        "runtime": "node -p \"process.version + '-' + process.platform + '-' + process.arch\""
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["default", "^default"],
      "dependsOn": ["^build"]
    },
    "typecheck": { "cache": true, "inputs": ["default", "^default"] },
    "test": { "cache": true, "inputs": ["default", "^default"] },
    "lint": { "cache": true, "inputs": ["default", "^default"] }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    }
  ],
  "nxCloudId": "6afb6fd0765b866d7b93eb5e"
}
