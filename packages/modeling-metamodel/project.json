{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "modeling-metamodel",
  "tags": ["scope:foundation", "type:metamodel", "lifecycle:unreleased"],
  "targets": {
    "test": {
      "dependsOn": [
        "build",
        "foundation-smoke",
        "package-check",
        "built-proof-check"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/proofs/**/*",
        "{workspaceRoot}/tools/packaging/**/*",
        "{workspaceRoot}/tools/boundaries/**/*",
        "{workspaceRoot}/tools/parity/**/*",
        "{workspaceRoot}/docs/consumer/**/*"
      ]
    },
    "foundation-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/proofs/foundation-smoke.mjs"
      },
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/tools/proofs/**/*"],
      "outputs": []
    },
    "package-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/packaging/check-packages.mjs"
      },
      "dependsOn": ["build", "boundary-check"],
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/packaging/**/*",
        "{workspaceRoot}/tools/boundaries/**/*",
        "{workspaceRoot}/docs/consumer/**/*"
      ],
      "outputs": []
    },
    "boundary-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/boundaries/policy.test.mjs && node tools/boundaries/check-workspace.mjs"
      },
      "dependsOn": ["build"],
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/boundaries/**/*"
      ],
      "outputs": []
    },
    "built-proof-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/parity/check-built-proofs.mjs"
      },
      "dependsOn": ["build"],
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/parity/**/*",
        "{workspaceRoot}/tools/boundaries/runtime-baseline.json",
        {
          "env": "FOUNDATION_PARITY_SOURCE_ROOT"
        }
      ],
      "outputs": []
    }
  }
}
